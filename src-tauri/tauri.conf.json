{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShadowBridge",
  "version": "1.0.1",
  "identifier": "com.shadowbridge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShadowBridge v1.0.1",
        "width": 1280,
        "height": 760,
        "minWidth": 900,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "decorations": true,
        "visible": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "licenseFile": "nsis/assets/license.rtf",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English"],
        "installMode": "currentUser",
        "headerImage": "nsis/assets/header.bmp",
        "sidebarImage": "nsis/assets/sidebar.bmp"
      }
    }
  }
}
